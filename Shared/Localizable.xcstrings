    "SideStore can only install marketplace apps that have been notarized by Apple.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore can only install marketplace apps that have been notarized by Apple."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 只能安裝經 Apple 公證的市集 App。"
          }
        }
      }
    },
    "SideStore cannot manage the existing certificate without owning its private key. The apps signed with the existing certificate will expire soon unless they are resigned and renewed explicitly by SideStore.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore cannot manage the existing certificate without owning its private key. The apps signed with the existing certificate will expire soon unless they are resigned and renewed explicitly by SideStore."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 若未擁有其私密金鑰，便無法管理現有的憑證。除非由 SideStore 明確重新簽名並續簽，否則使用現有憑證簽名的 App 將很快到期。"
          }
        }
      }
    },
    "SideStore communicates with on-device services over a local loopback VPN. Enable LocalDevVPN before verifying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore communicates with on-device services over a local loopback VPN. Enable LocalDevVPN before verifying."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 透過本機迴路 VPN 與裝置上的服務通訊。驗證前請先啟用 LocalDevVPN。"
          }
        }
      }
    },
    "SideStore does not have detailed information for these entitlements.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore does not have detailed information for these entitlements."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 沒有這些 entitlement 的詳細資訊。"
          }
        }
      }
    },
    "SideStore requires an Apple ID to create development certificates and provisioning profiles for signing apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore requires an Apple ID to create development certificates and provisioning profiles for signing apps."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 需要 Apple ID 來建立開發憑證和佈建描述檔以簽署 App。"
          }
        }
      }
    },
    "SideStore setup is complete. You can now install and refresh apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore setup is complete. You can now install and refresh apps."
