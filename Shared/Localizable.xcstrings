    },
    "Free developer accounts are limited to 1 active signing certificate. Since the private key for the active certificate was not found on this device, SideStore will create a new certificate. This will automatically revoke the active certificate, which may disable installations on other devices or made by Xcode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free developer accounts are limited to 1 active signing certificate. Since the private key for the active certificate was not found on this device, SideStore will create a new certificate. This will automatically revoke the active certificate, which may disable installations on other devices or made by Xcode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費開發者帳號僅限 1 張使用中的簽署憑證。由於在此裝置上找不到使用中憑證的私鑰，SideStore 將建立新憑證。這將自動撤銷使用中的憑證，可能導致在其他裝置上或由 Xcode 進行的安裝失效。"
          }
        }
      }
    },
    "Free up disk space by removing non-essential data, such as temporary files and backups for uninstalled apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
