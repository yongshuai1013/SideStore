            "value": "These are permissions required by “%@” that SideStore does not recognize. Make sure you understand them before continuing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是「%@」所需的權限，但 SideStore 無法辨識。在繼續之前，請確保你了解這些權限。"
          }
        }
      }
    },
    "These permissions must be declared by the source in order for SideStore to install this app:": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These permissions must be declared by the source in order for SideStore to install this app:"
          }
        },
