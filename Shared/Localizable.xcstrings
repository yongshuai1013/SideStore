          "stringUnit": {
            "state": "translated",
            "value": "來源必須宣告這些權限，SideStore 才能安裝此 App："
          }
        }
      }
    },
    "These updates don't support iOS %@. Please update your device to the latest iOS version to install them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
