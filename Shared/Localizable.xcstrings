    "'%@' exists on the Apple Developer Portal. Do you want to delete it from Apple's servers as well, or only delete the local cache?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' exists on the Apple Developer Portal. Do you want to delete it from Apple's servers as well, or only delete the local cache?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已存在於 Apple Developer Portal。你要同時從 Apple 的伺服器刪除，還是只刪除本機快取？"
          }
        }
      }
    },
    "'Device IP' and 'RemotePair Port' are optional and if specified should match exactly as in the target VPN's config or Leave empty to prefer auto-discovery/default port %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'Device IP' and 'RemotePair Port' are optional and if specified should match exactly as in the target VPN's config or Leave empty to prefer auto-discovery/default port %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「Device IP」與「RemotePair Port」為選填，若有填寫，必須與目標 VPN 設定中的值完全一致，或留空以優先使用自動探索／預設連接埠 %@。"
          }
        }
      }
    },
